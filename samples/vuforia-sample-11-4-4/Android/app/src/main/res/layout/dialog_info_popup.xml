<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/info_popup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/info_popup_card"
        android:layout_width="match_parent"
        android:layout_height="336dp"
        android:layout_gravity="center"
        android:layout_marginHorizontal="48dp"
        android:background="@drawable/bg_info_popup_card"
        android:clickable="true"
        android:focusable="true"
        android:foregroundGravity="center_horizontal"
        android:padding="20dp">

        <!-- Shimmer overlay -->
        <View
            android:id="@+id/info_popup_shimmer"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:alpha="0.3"
            android:background="@drawable/bg_info_popup_shimmer" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.vuforia.engine.native_sample.ScanFrameView
                android:id="@+id/info_popup_scan_frame"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/info_popup_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="AIM &amp; WATCH"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/info_popup_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </LinearLayout>

    </FrameLayout>

</FrameLayout>
